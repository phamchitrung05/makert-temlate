APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_PUBLIC_DISK=media_public
MEDIA_PRIVATE_DISK=media_private
MEDIA_LIBRARY_SEED=false
MEDIA_MAX_FILE_SIZE=536870912
MEDIA_IMAGE_MAX_SIZE_KB=10240
MEDIA_DOCUMENT_MAX_SIZE_KB=25600
MEDIA_ARCHIVE_MAX_SIZE_KB=512000
MEDIA_VIDEO_MAX_SIZE_KB=512000
MEDIA_ARCHIVE_MAX_ENTRIES=10000
MEDIA_ARCHIVE_MAX_UNCOMPRESSED_BYTES=1073741824
MEDIA_ARCHIVE_MAX_COMPRESSION_RATIO=100
QUEUE_CONNECTION=database

# AI article import: giữ key ở backend, không đưa vào VITE_*.
AI_IMPORT_ENABLED=true
AI_IMPORT_PROVIDER=deterministic
AI_IMPORT_ENDPOINT=
AI_IMPORT_KEY=
AI_IMPORT_MODEL=default
AI_IMPORT_TIMEOUT=12

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL=
VITE_ENABLE_MSW=false
VITE_MAPBOX_ACCESS_TOKEN=

# Tiny Cloud: dán API key vào đây, sau đó khởi động lại Vite hoặc build lại.
# Key này được dùng ở trình duyệt; không nhập secret/token quản trị vào đây.
VITE_TINYMCE_API_KEY=
# Dùng Tiny Cloud thì để trống. Chỉ đặt gpl khi chủ dự án chọn GPL self-host.
VITE_TINYMCE_LICENSE_KEY=
